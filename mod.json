{
    "geode": "5.11.2",
    "gd": { "android": "2.2081", "win": "2.2081" },
    "version": "v11.0.0",
    "id": "owenpro2016-cmyk.aftermobile-beta",
    "name": "Aftermobile Pro",
    "developer": "owenpro2016-cmyk",
    "description": "Motor definitivo: CAF, Buffer Predictivo y Memoria de Nivel.",
    "platforms": ["android32", "android64", "win"],
    "settings": {
        "core-title": { "type": "title", "name": "Motor de Asistencia" },
        "assist-mode": { 
            "type": "string", 
            "name": "Modo de Asistencia", 
            "default": "Balanceado",
            "one-of": ["Desactivado", "Suave", "Balanceado", "Extremo"]
        },
        "caf-enabled": { "type": "bool", "name": "Click After Frames (CAF)", "default": true },
        "level-memory": { "type": "bool", "name": "Memoria de Nivel", "default": true },
        
        "ui-title": { "type": "title", "name": "Interfaz Visual" },
        "ui-primary-color": { "type": "color", "name": "Color Principal", "default": "#00FF00" },
        "ui-surface-color": { "type": "color", "name": "Color de Fondo", "default": "#16161A" },
        "show-hud": { "type": "bool", "name": "Mostrar Bolita AM", "default": true },
        "show-hitboxes": { "type": "bool", "name": "Mostrar Hitboxes", "default": false },
        "show-traj": { "type": "bool", "name": "Mostrar Trayectoria", "default": true }
    }
}
