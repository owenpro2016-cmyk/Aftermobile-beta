{
    "geode": "5.11.2",
    "gd": { "android": "2.2081", "win": "2.2081" },
    "version": "v6.0.0",
    "id": "owenpro2016-cmyk.aftermobile-beta",
    "name": "Aftermobile Prime",
    "developer": "owenpro2016-cmyk",
    "description": "Suite definitiva de asistencia: Fisica predictiva, buffer de inputs, portales, replay y UI personalizable.",
    "platforms": ["android32", "android64", "win"],
    "settings": {
        "core-title": { "type": "title", "name": "Motor AeroEngine" },
        "assist-stage": {
            "type": "string",
            "name": "Nivel de Asistencia",
            "description": "Controla cuantos ticks puede retener el mod tus clicks para salvarte.",
            "default": "Balanceado",
            "one-of": ["Desactivado", "Suave (1 Tk)", "Balanceado (3 Tk)", "Extremo (8 Tk)"]
        },
        "predict-portals": { "type": "bool", "name": "Predecir a traves de Portales", "default": true },
        "absorb-releases": { "type": "bool", "name": "Absorber Micro-Sueltes (Nave/Wave)", "default": true },
        
        "tools-title": { "type": "title", "name": "Herramientas" },
        "show-hitboxes": { "type": "bool", "name": "Mostrar Hitboxes", "default": false },
        "show-prediction": { "type": "bool", "name": "Mostrar Trayectoria Predictiva", "default": true },
        "enable-replay": { "type": "bool", "name": "Grabar y Reproducir Inputs", "default": false },
        
        "ui-title": { "type": "title", "name": "Interfaz Visual" },
        "ui-primary-color": { "type": "color", "name": "Color Principal", "default": "#00FF00" },
        "ui-surface-color": { "type": "color", "name": "Color de Fondo", "default": "#16161A" },
        "ui-glow": { "type": "bool", "name": "Efecto de Brillo", "default": true },
        "show-hud": { "type": "bool", "name": "Mostrar Bolita AM", "default": true }
    }
}
